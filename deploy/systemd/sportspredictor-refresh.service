[Unit]
Description=SportsPredictor refresh (freeze predictions, grade results, save market prices)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -u -m src.refresh --all
# Output goes to the journal: journalctl -u sportspredictor-refresh

[Unit]
Description=Run the SportsPredictor refresh every 3 hours

[Timer]
# Same slots as the Mac's launchd agent: 00:05, 03:05, ... US Central time.
OnCalendar=*-*-* 00/3:05:00 America/Chicago
# A slot missed while the server was down runs once when it comes back.
Persistent=true

[Install]
WantedBy=timers.target

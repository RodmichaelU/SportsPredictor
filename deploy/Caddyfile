# Caddy terminates HTTPS (automatic Let's Encrypt certificate for $DOMAIN)
# and routes one public hostname to the two local processes:
#   /api/*  -> FastAPI (uvicorn, 127.0.0.1:8000), with the /api prefix stripped
#   /*      -> Next.js (127.0.0.1:3000)
# Neither app listens publicly; only Caddy does, on 80/443.
{$DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

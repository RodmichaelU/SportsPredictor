<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sportspredictor.refresh</string>

    <!-- Inlined rather than pointing at scripts/refresh.sh: a script file
         created by an editor/agent tool can pick up a macOS "provenance" tag
         that blocks launchd (an unrelated process) from exec'ing it directly
         -- /bin/bash itself carries no such tag, so invoking through -c
         sidesteps that entirely. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "/Users/rj/Desktop/Side Projects/SportsPredictor" &amp;&amp; exec .venv/bin/python -u -m src.refresh --all</string>
    </array>

    <!-- Every 3 hours (00:05, 03:05, ... local time): frequent enough to
         catch newly-finished games same day without burning meaningfully
         into CFBD's 1,000 calls/month (each run costs ~5 CFB calls once the
         season's cache is busted).

         Calendar times rather than StartInterval on purpose: StartInterval's
         timer doesn't advance while the Mac sleeps, so a laptop closed
         overnight could go most of a day without a refresh. A missed
         calendar slot instead runs once on wake (multiple missed slots are
         coalesced into one run). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
    </array>

    <!-- Also run once as soon as the agent is loaded, so `launchctl load`
         doesn't leave a 3-hour wait before the first refresh. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/rj/Desktop/Side Projects/SportsPredictor/data/logs/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rj/Desktop/Side Projects/SportsPredictor/data/logs/refresh.log</string>
</dict>
</plist>
